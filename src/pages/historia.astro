<script>
  /* ── La crónica: hilo conductor + parallax de las fotos ──
     Un único listener de scroll, con rAF, para las dos cosas. */
  function initCronica() {
    const cronica = document.querySelector<HTMLElement>('.cronica');
    if (!cronica) return;

    const progreso = cronica.querySelector<HTMLElement>('.cronica-progreso');
    const fotos = Array.from(cronica.querySelectorAll<HTMLImageElement>('.cap-marco img'));
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let raf = 0;

    const pintar = () => {
      raf = 0;
      const vh = window.innerHeight;

      // Hilo: se rellena según cuánto del bloque ha pasado por el centro.
      if (progreso) {
        const r = cronica.getBoundingClientRect();
        const avance = (vh * 0.5 - r.top) / r.height;
        progreso.style.height = `${Math.min(Math.max(avance, 0), 1) * 100}%`;
      }

      // Parallax: solo en las fotos que están (casi) en pantalla.
      if (!sinMovimiento) {
        for (const img of fotos) {
          const marco = img.parentElement!;
          const r = marco.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) continue;
          const desvio = r.top + r.height / 2 - vh / 2;
          img.style.transform = `translate3d(0, ${(-desvio * 0.045).toFixed(1)}px, 0)`;
        }
      }
    };

    const pedirPintado = () => { if (!raf) raf = requestAnimationFrame(pintar); };

    window.addEventListener('scroll', pedirPintado, { passive: true });
    window.addEventListener('resize', pedirPintado);
    pintar();
  }

  initCronica();
</script>
