---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardLugar from '../components/CardLugar.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { esVisible } from '../utils/contenido';

const todosLosPuntos = (await getCollection('puntos')).filter(esVisible);

// Servicios del pueblo (puntos tipo "servicio"), agrupados por categoría
// para los modales de Dormir y Comer.
const servicios = todosLosPuntos.filter(p => p.data.tipo === 'servicio');
const alojamientosZona = servicios.filter(p => p.data.categoria === 'dormir');
const restaurantesZona = servicios.filter(p => p.data.categoria === 'comer');

// ── Navegación interna de la página ───────────────
// El mapa interactivo (antes 'Explora') está desactivado por ahora.
const indice = [
  { label: 'Imprescindibles', href: '#imprescindibles' },
  { label: 'Gastronomía',     href: '#gastronomia' },
  { label: 'Dormir',          href: '#dormir' },
];

// ── Por qué alojarte en Arcusa ────────────────────
const porQue = [
  { icon: 'compass',   titulo: 'Todo a un paso',     texto: 'Aínsa, Ordesa, Guara, Alquézar. Sales por la mañana y a mediodía estás de vuelta a comer. Aquí no se pierde medio viaje conduciendo.' },
  { icon: 'tree-pine', titulo: 'Silencio de verdad', texto: 'Cuando cae el día, el mayor ruido de Arcusa es el viento entre las montañas. Ni colas, ni bocinas, ni prisa.' },
  { icon: 'star',      titulo: 'La noche se ve',     texto: 'El Sobrarbe es Destino Starlight. Levantas la vista y ahí está la Vía Láctea, como antes de que existieran las ciudades.' },
  { icon: 'palette',   titulo: 'Patrimonio vivo',    texto: 'Calles de piedra y un museo pintado en las fachadas. En Arcusa no duermes al lado de la historia: duermes dentro.' },
];

// ── Imprescindibles (4 grandes) ───────────────────
const imprescindibles = [
  {
    nombre: 'Aínsa',
    eyebrow: 'Villa medieval',
    distancia: '~15 min',
    icon: 'castle',
    img: '/images/que-ver/ainsa.webp',
    grad: 'linear-gradient(135deg, #C3D7E6 0%, #7F9BBE 100%)',
    desc: 'Cruzas la puerta de la muralla y, de golpe, estás en el siglo XII. La plaza porticada, el castillo, las callejuelas. Sube al atardecer: cuando el sol cae tras los Pirineos, nadie habla.',
  },
  {
    nombre: 'Alquézar',
    eyebrow: 'Pueblo y cañón',
    distancia: '~45 min',
    icon: 'church',
    img: '/images/que-ver/alquezar.webp',
    grad: 'linear-gradient(135deg, #E8A96A 0%, #C4773D 100%)',
    desc: 'Un puñado de casas colgadas sobre el cañón del Vero, con la colegiata vigilando desde arriba. Y abajo, las pasarelas suspendidas sobre el río: el paseo que todo el mundo acaba haciendo. Da un poco de vértigo. Merece cada paso.',
  },
  {
    nombre: 'Parque Nacional de Ordesa',
    eyebrow: 'Naturaleza mayúscula',
    distancia: '~1 h',
    icon: 'mountain',
    img: '/images/que-ver/ordesa.webp',
    grad: 'linear-gradient(135deg, #7C8A5C 0%, #3E5C3A 100%)',
    desc: 'Hay sitios que impresionan en una foto. Ordesa impresiona mucho más cuando estás dentro. Valles tallados por el hielo, cascadas una detrás de otra y paredes que te obligan a mirar hacia arriba. Se va una vez y se vuelve toda la vida.',
  },
  {
    nombre: 'Sierra de Guara',
    eyebrow: 'Roca y agua',
    distancia: '~40 min',
    icon: 'waves',
    img: '/images/que-ver/guara.webp',
    grad: 'linear-gradient(135deg, #CDBBA0 0%, #6B5842 100%)',
    desc: 'El reino de los cañones. Agua turquesa abriéndose paso entre paredes de roca que lleva milenios esculpiendo. Es la capital mundial del barranquismo, pero no hace falta tirarse: basta con asomarse.',
  },
];

// ── Gastronomía ───────────────────────────────────
const gastronomiaImg = '/images/que-ver/gastronomia.webp'
const productos = [
  { n: 'Ternasco de Aragón', icon: 'utensils' },
  { n: 'Chiretas',           icon: 'utensils' },
  { n: 'Longaniza',          icon: 'utensils' },
  { n: 'Quesos del Pirineo', icon: 'utensils' },
  { n: 'Miel de montaña',    icon: 'sparkles' },
  { n: 'Aceite',             icon: 'sparkles' },
  { n: 'Vinos D.O. Somontano', icon: 'star' },
];

// ── Dormir ────────────────────────────────────────
const alojamiento = [
  { icon: 'home',     titulo: 'Casas rurales',  texto: 'La forma más honesta de dormir en el Sobrarbe. En la propia Arcusa, piedra con siglos y chimenea encendida.' },
  { icon: 'building', titulo: 'Hoteles',        texto: 'En Aínsa, Boltaña y alrededores, desde hoteles con encanto a opciones para toda la familia.' },
  { icon: 'tree-pine', titulo: 'Campings',      texto: 'Para los que prefieren dormirse oyendo el río y despertarse entre pinos.' },
  { icon: 'bed',      titulo: 'Apartamentos',   texto: 'Tu espacio y tu ritmo, ideales para estancias largas o viajes en familia.' },
];

---

<Layout
  title="Descubre el Sobrarbe desde Arcusa – Qué ver y hacer"
  description="Arcusa es el mejor punto de partida para descubrir el Sobrarbe: Aínsa, Alquézar, Ordesa, la Sierra de Guara, pueblos medievales, cañones, rutas y experiencias en el Pirineo aragonés."
>
  <Navigation />

  <!-- ══════════ 1 · HERO ══════════ -->
  <section
    class="relative flex items-end overflow-hidden"
    style="height: 88svh; min-height: 600px;"
    aria-label="Descubre el Sobrarbe desde Arcusa"
  >
    <img
      src="/images/hero/Header4.webp"
      alt="Paisaje de montañas del Sobrarbe, en el Pirineo aragonés"
      class="absolute inset-0 w-full h-full object-cover"
      style="object-position: center 30%;"
      fetchpriority="high"
    />
    <!-- Velo para legibilidad -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to top, rgba(20,24,28,0.78) 0%, rgba(20,24,28,0.32) 45%, rgba(20,24,28,0.18) 100%);"
    ></div>
    <!-- Transición al cuerpo -->
    <div
      class="absolute inset-x-0 bottom-0 h-32 pointer-events-none"
      style="background: linear-gradient(to bottom, transparent, var(--color-pergamino));"
    ></div>

    <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 md:pb-28">
      <div
        class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full"
        style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.85);"
      >
        <Icon name="map-pin" size={12} />
        <span class="text-xs font-semibold uppercase tracking-[0.22em]">Sobrarbe · Pirineo Aragonés</span>
      </div>
      <h1
        class="font-serif font-bold text-white"
        style="font-size: clamp(2.5rem, 7vw, 5rem); line-height: 1.02; letter-spacing: -0.02em; text-shadow: 0 1px 3px rgba(0,0,0,0.5), 0 2px 16px rgba(0,0,0,0.4);"
      >
        El Sobrarbe<br />empieza aquí
      </h1>
      <p
        class="mt-6 max-w-2xl leading-relaxed"
        style="color: rgba(255,255,255,0.9); font-size: clamp(1rem, 2.2vw, 1.25rem); text-shadow: 0 1px 3px rgba(0,0,0,0.5), 0 2px 16px rgba(0,0,0,0.4);"
      >
        Castillos colgados sobre el vacío, pueblos medievales donde el tiempo parece haberse
        parado, cañones de agua turquesa y montañas que se te quedan grabadas mucho después
        de volver a casa.
      </p>
      <p
        class="mt-7 flex items-center gap-3.5 font-serif font-semibold text-white"
        style="font-size: clamp(1.3rem, 3.2vw, 2rem); line-height: 1.15; text-shadow: 0 1px 3px rgba(0,0,0,0.5), 0 2px 16px rgba(0,0,0,0.4);"
      >
        <span
          class="inline-flex items-center justify-center w-11 h-11 rounded-full flex-shrink-0"
          style="background: rgba(232,169,106,0.16); color: var(--color-ocre-suave); border: 1px solid rgba(232,169,106,0.4);"
        >
          <Icon name="clock" size={21} />
        </span>
        <span>Y todo, a <span style="color: var(--color-ocre-suave); white-space: nowrap;">menos de una hora</span> de Arcusa.</span>
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#imprescindibles" class="btn-primary">
          Empezar a descubrir
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- Índice de navegación -->
  <div
    class="sticky top-0 z-30 hidden md:block"
    style="background: rgba(244,239,230,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(156,133,103,0.15);"
  >
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-1 overflow-x-auto" aria-label="Secciones">
      {indice.map(item => (
        <a
          href={item.href}
          class="whitespace-nowrap px-4 py-3.5 text-xs font-semibold uppercase tracking-wide transition-colors hover:text-[var(--color-ocre)]"
          style="color: var(--color-piedra-media);"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- ══════════ 2 · POR QUÉ ALOJARTE ══════════ -->
  <section class="bg-section-warm py-20 md:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-5">
          <SectionHeader
            eyebrow="El campamento base perfecto"
            title="¿Por qué alojarte en Arcusa?"
          />
          <div class="prose-arcusa">
            <p>
              El Sobrarbe no se queda corto de planes. El problema es elegir. Y para eso, lo
              mejor es dormir justo en el centro de todo.
            </p>
            <p>
              Desde Arcusa tienes la comarca entera al alcance —Aínsa, Ordesa, Guara, Alquézar—.
              Pasas el día fuera y al volver te espera un pueblo de piedra en silencio, con uno
              de los cielos más limpios del Pirineo sobre la cabeza. Aventura de día, calma de
              noche.
            </p>
          </div>
        </div>
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {porQue.map((b, i) => (
            <div
              class={`reveal reveal-d${i + 1} rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1`}
              style="background: white; border: 1px solid rgba(156,133,103,0.12); box-shadow: 0 2px 8px rgba(46,42,36,0.04);"
            >
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
                style="background: var(--color-pergamino); color: var(--color-piedra-oscura);"
              >
                <Icon name={b.icon} size={22} />
              </div>
              <h3 class="font-serif text-lg font-semibold mb-2" style="color: var(--color-carbon);">{b.titulo}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-carbon-suave);">{b.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 3 · IMPRESCINDIBLES ══════════ -->
  <section id="imprescindibles" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <SectionHeader
      eyebrow="Lo que no te puedes perder"
      title="Cuatro imprescindibles"
      subtitle="Si solo tuvieras un fin de semana, irías a estos cuatro sitios. Y a ninguno tardas más de una hora en llegar."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {imprescindibles.map((d, i) => (
        <article
          class={`reveal reveal-d${(i % 2) + 1} card-3d rounded-3xl overflow-hidden flex flex-col`}
          style="background: white; border: 1px solid rgba(156,133,103,0.12);"
        >
          <div class="relative flex items-end overflow-hidden" style={`aspect-ratio: 16/10; background: ${d.grad};`}>
            {d.img && (
              <img src={d.img} alt={d.nombre} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
            )}
            {d.img && (
              <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,24,28,0.7) 0%, transparent 55%);"></div>
            )}
            <div
              class="absolute top-4 right-4 z-10 flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full"
              style="background: rgba(255,255,255,0.85); color: var(--color-carbon); backdrop-filter: blur(4px);"
            >
              <Icon name="clock" size={11} />
              {d.distancia}
            </div>
            {!d.img && (
              <div class="absolute right-5 bottom-4 opacity-25 text-white"><Icon name={d.icon} size={72} /></div>
            )}
            <div class="relative z-10 p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] mb-1" style="color: rgba(255,255,255,0.85);">{d.eyebrow}</p>
              <h3 class="font-serif text-2xl md:text-3xl font-bold text-white" style="text-shadow: 0 1px 12px rgba(0,0,0,0.25);">{d.nombre}</h3>
            </div>
          </div>
          <div class="p-6 flex-1">
            <p class="leading-relaxed" style="color: var(--color-carbon-suave);">{d.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════ 4 · GASTRONOMÍA ══════════ -->
  <section id="gastronomia" style="background: white;" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <SectionHeader
          eyebrow="Sabor de montaña"
          title="Comer en el Sobrarbe"
        />
        <div class="prose-arcusa">
          <p>
            Aquí se come para reponer fuerzas, no para hacer fotos. Cocina de montaña, honesta
            y contundente, hecha con lo que da la tierra y pensada para después de un día largo.
          </p>
          <p>
            En Arcusa y los pueblos de al lado todavía se guisa como siempre. Y si te llevas
            algo a casa, que sea de aquí: sabe distinto.
          </p>
        </div>
        <p class="mt-8 text-xs font-semibold uppercase tracking-[0.18em] mb-4" style="color: var(--color-ocre);">
          Productos típicos
        </p>
        <div class="flex flex-wrap gap-2.5">
          {productos.map(p => (
            <span
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium"
              style="background: var(--color-pergamino); border: 1px solid rgba(156,133,103,0.2); color: var(--color-carbon-suave);"
            >
              <Icon name={p.icon} size={13} style="color: var(--color-piedra-media);" />
              {p.n}
            </span>
          ))}
        </div>
        {restaurantesZona.length > 0 && (
          <div class="mt-8">
            <button type="button" class="btn-outline" data-open-modal="modal-comer">
              <Icon name="utensils" size={15} />
              Ver dónde comer en la zona
            </button>
          </div>
        )}
      </div>
      <div
        class="rounded-3xl overflow-hidden flex items-center justify-center"
        style="aspect-ratio: 4/3; background: linear-gradient(135deg, var(--color-pergamino) 0%, var(--color-piedra-clara) 100%);"
      >
        {gastronomiaImg ? (
          <img src={gastronomiaImg} alt="Gastronomía del Sobrarbe" loading="lazy" decoding="async" class="w-full h-full object-cover" />
        ) : (
          <div class="text-center" style="color: var(--color-piedra-media);">
            <Icon name="utensils" size={48} class="mx-auto mb-3 opacity-40" />
            <p class="text-sm">Fotografía próximamente</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ══════════ 5 · DORMIR ══════════ -->
  <section id="dormir" class="bg-section-white-warm py-20 md:py-28 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <SectionHeader
        eyebrow="Tu base en el Sobrarbe"
        title="Dónde dormir"
        subtitle="Desde casas de piedra hasta una tienda junto al río. Vengas como vengas, hay un sitio para caer rendido."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {alojamiento.map((a, i) => (
          <div
            class={`reveal reveal-d${i + 1} rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1`}
            style="background: white; border: 1px solid rgba(156,133,103,0.12); box-shadow: 0 2px 8px rgba(46,42,36,0.04);"
          >
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
              style="background: var(--color-pergamino); color: var(--color-piedra-oscura);"
            >
              <Icon name={a.icon} size={22} />
            </div>
            <h3 class="font-serif text-lg font-semibold mb-2" style="color: var(--color-carbon);">{a.titulo}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-carbon-suave);">{a.texto}</p>
          </div>
        ))}
      </div>
      {alojamientosZona.length > 0 && (
        <div class="mt-8 flex justify-center">
          <button type="button" class="btn-outline" data-open-modal="modal-dormir">
            <Icon name="bed" size={15} />
            Ver alojamientos de la zona
          </button>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════ Enlace a Arcusa de noche ══════════ -->
  <section class="bg-section-dark py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-6 md:gap-10 text-center md:text-left">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center flex-shrink-0" style="background: rgba(159,192,224,0.14); color:#9FC0E0;">
        <Icon name="moon" size={30} />
      </div>
      <div class="flex-1">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] mb-2" style="color: rgba(232,169,106,0.9);">Cuando se apaga el día</p>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-white mb-2">Y cuando se hace de noche, esto no se acaba</h2>
        <p class="leading-relaxed" style="color: rgba(255,255,255,0.72);">Apenas una farola, silencio absoluto y más estrellas de las que creías que existían. Arcusa fue el primer Destino Starlight de Huesca.</p>
      </div>
      <a href="/arcusa-de-noche" class="btn-ghost flex-shrink-0">
        <Icon name="moon" size={15} />
        Arcusa de noche
      </a>
    </div>
  </section>

  <!-- ══════════ 6 · CTA FINAL ══════════ -->
  <section class="bg-section-blue py-24 px-4">
    <div class="max-w-2xl mx-auto text-center text-white">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] mb-5" style="color: rgba(255,255,255,0.6);">
        Lo difícil no es llegar. Es marcharse.
      </p>
      <h2 class="font-serif font-bold leading-tight mb-5" style="font-size: clamp(1.9rem, 4.5vw, 3rem);">
        Algunos sitios se visitan. El Sobrarbe se recuerda.
      </h2>
      <p class="text-lg leading-relaxed mb-9" style="color: rgba(255,255,255,0.82);">
        Pueblos colgados de la roca, cañones de agua turquesa, un parque nacional y un cielo
        lleno de estrellas. Todo alrededor de un pueblo de piedra que sigue a su ritmo. El
        Sobrarbe lleva aquí miles de años. Solo falta que pongas la fecha.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/museo"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold transition-all hover:scale-105"
          style="background: white; color: var(--color-azul-pirineo);"
        >
          <Icon name="palette" size={15} />
          Explorar el pueblo
        </a>
        <a
          href="/historia"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold transition-all hover:scale-105"
          style="border: 1.5px solid rgba(255,255,255,0.4); color: white;"
        >
          <Icon name="scroll" size={15} />
          Conoce su historia
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════ Modales: lugares de la zona ══════════ -->
  {alojamientosZona.length > 0 && (
    <div id="modal-dormir" class="lugares-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Alojamientos de la zona">
      <div class="lugares-backdrop" data-close-modal></div>
      <div class="lugares-card" role="document">
        <div class="lugares-head">
          <div>
            <p class="lugares-eyebrow">Dónde dormir</p>
            <h3 class="lugares-title">Alojamientos de la zona</h3>
          </div>
          <button type="button" class="lugares-close" data-close-modal aria-label="Cerrar">
            <Icon name="x" size={18} />
          </button>
        </div>
        <div class="lugares-grid">
          {alojamientosZona.map(l => (
            <CardLugar
              nombre={l.data.nombre}
              categoria={l.data.categoria!}
              descripcion={l.data.descripcion ?? l.data.resumen}
              imagen={l.data.imagenes[0]}
              distancia={l.data.distancia}
              contacto={l.data.contacto}
              enlace={l.data.enlace}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  {restaurantesZona.length > 0 && (
    <div id="modal-comer" class="lugares-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Dónde comer en la zona">
      <div class="lugares-backdrop" data-close-modal></div>
      <div class="lugares-card" role="document">
        <div class="lugares-head">
          <div>
            <p class="lugares-eyebrow">Dónde comer</p>
            <h3 class="lugares-title">Restaurantes de la zona</h3>
          </div>
          <button type="button" class="lugares-close" data-close-modal aria-label="Cerrar">
            <Icon name="x" size={18} />
          </button>
        </div>
        <div class="lugares-grid">
          {restaurantesZona.map(l => (
            <CardLugar
              nombre={l.data.nombre}
              categoria={l.data.categoria!}
              descripcion={l.data.descripcion ?? l.data.resumen}
              imagen={l.data.imagenes[0]}
              distancia={l.data.distancia}
              contacto={l.data.contacto}
              enlace={l.data.enlace}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  <Footer />
</Layout>

<style>
  .lugares-modal {
    position: fixed; inset: 0; z-index: 120;
    display: flex; align-items: flex-start; justify-content: center;
    padding: clamp(1rem, 6vh, 4rem) 1rem;
    overflow-y: auto;            /* el scroll vive aquí, no en la tarjeta */
    opacity: 0; visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .lugares-modal.open { opacity: 1; visibility: visible; pointer-events: auto;}
  .lugares-backdrop {
    position: absolute; inset: 0;
    background: rgba(46,42,36,0.55);
    backdrop-filter: blur(3px);
  }
  .lugares-card {
    position: relative;
    width: 100%; max-width: 900px;
    margin: auto;               /* centrado vertical cuando hay sitio; sin recortar sombras */
    background: var(--color-pergamino);
    border-radius: 1.25rem;
    box-shadow: 0 24px 60px rgba(46,42,36,0.35);
    padding: 1.5rem;
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), opacity 0.28s ease;
  }
  .lugares-modal.open .lugares-card { transform: translateY(0) scale(1); opacity: 1; }
  .lugares-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.4rem;
  }
  .lugares-eyebrow {
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--color-ocre); margin-bottom: 0.25rem;
  }
  .lugares-title {
    font-family: var(--font-serif);
    font-size: 1.5rem; font-weight: 700; line-height: 1.15;
    color: var(--color-carbon);
  }
  .lugares-close {
    flex-shrink: 0;
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: white; color: var(--color-carbon);
    border: 1px solid rgba(156,133,103,0.25);
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .lugares-close:hover { transform: scale(1.08); }
  .lugares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
  }
  /* Tarjetas del modal: hover propio, claro y fiable.
     Anulamos will-change/preserve-3d (código muerto del tilt 3D que
     creaba capas de composición y rompía la interacción de la 1ª card). */
  .lugares-grid :global(.card-3d) {
    will-change: auto;
    transform-style: flat;
    transform: none;
    opacity: 1;                 /* no dependemos del IntersectionObserver dentro del modal */
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s ease;
  }
  .lugares-grid :global(.card-3d:hover) {
    transform: translateY(-6px);
    box-shadow:
      0 22px 44px rgba(46, 42, 36, 0.18),
      0 6px 16px rgba(91, 127, 166, 0.12);
  }
  @media (prefers-reduced-motion: reduce) {
    .lugares-modal, .lugares-card { transition: none; }
  }
</style>

<script>
  function setupLugaresModales() {
    const abrir = (id: string) => {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.add('open');
      m.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const cerrar = (m: Element) => {
      m.classList.remove('open');
      m.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach(btn => {
      btn.addEventListener('click', () => abrir(btn.dataset.openModal!));
    });
    document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach(el => {
      el.addEventListener('click', () => {
        const m = el.closest('.lugares-modal');
        if (m) cerrar(m);
      });
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.lugares-modal.open').forEach(cerrar);
      }
    });
  }
  setupLugaresModales();
</script>
