---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HeroParallax from '../components/HeroParallax.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardLugar from '../components/CardLugar.astro';
import CardEvento from '../components/CardEvento.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { pueblo } from '../data/pueblo';
import { LOCALIZACIONES_TRIVIAL } from '../data/trivial';

const totalSecretos = LOCALIZACIONES_TRIVIAL.length;

const proximosEventos = (await getCollection('eventos'))
  .filter(e => new Date(e.data.fecha) >= new Date())
  .sort((a, b) => new Date(a.data.fecha).getTime() - new Date(b.data.fecha).getTime())
  .slice(0, 3);

const lugaresDestacados = (await getCollection('lugares'))
  .filter(l => ['ver', 'actividad'].includes(l.data.categoria))
  .slice(0, 4);
---

<Layout
  title="Arcusa – El Pueblo Museo del Biello Sobrarbe"
  description="Arcusa, en el Biello Sobrarbe, es un pueblo del Pirineo aragonés donde la historia medieval, la arquitectura tradicional y el museo de pintura al aire libre conviven entre montañas.">
  <Navigation />
  <HeroParallax />

  <!-- Presentación ──────────────────────────────── -->
  <section id="presentacion" class="bg-section-warm max-w-[100%] px-4 sm:px-6 lg:px-8 py-20 md:py-28">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Texto -->
      <div>
        <SectionHeader
          eyebrow="Biello Sobrarbe · Pirineo Aragonés"
          title="Mil años de historia entre montañas"
        />
        <div class="prose-arcusa">
          <p>
            En el corazón del Biello Sobrarbe, entre montañas que anuncian la Sierra de Guara, Arcusa conserva
            una historia que empezó hace casi mil años y que todavía se recorre a pie, calle a calle.
          </p>
          <p>
            Hay pueblos que se visitan por un monumento concreto. Arcusa se descubre por todo lo que es capaz de contar.
          </p>
          <p>
            Una torre medieval que vio nacer el Reino de Aragón. Casas señoriales que llevan el nombre de quienes
            las levantaron. Y, sobre las fachadas, un museo de pintura al aire libre que mantiene viva la memoria del pueblo.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/museo" class="btn-primary">
            <Icon name="palette" size={15} />
            Ver el museo al aire libre
          </a>
          <a href="/historia" class="btn-outline">
            <Icon name="scroll" size={15} />
            Historia del pueblo
          </a>
        </div>
      </div>

      <!-- Datos rápidos con contador animado -->
      <div class="grid grid-cols-2 gap-4">
        {[
          {
            icon: 'mountain',
            iconColor: '#5B7FA6',
            iconBg:    '#EAF2FA',
            static: `~${pueblo.altitud}`,
            suffix: ' m',
            label: 'Altitud sobre el nivel del mar',
          },
          {
            icon: 'users',
            iconColor: '#3E5C3A',
            iconBg:    '#E8F0E8',
            count: pueblo.habitantes,
            prefix: '~',
            label: 'Habitantes censados que mantienen vivo el pueblo durante todo el año',
          },
          {
            icon: 'castle',
            iconColor: '#9C8567',
            iconBg:    '#F2EDE6',
            static: pueblo.anioTorre,
            label: 'Casi mil años vigilando el Sobrarbe',
          },
          {
            icon: 'palette',
            iconColor: '#C4773D',
            iconBg:    '#FAF0E6',
            count: pueblo.murales,
            suffix: '+',
            label: 'Murales que convierten las calles en un museo al aire libre',
          },
        ].map((dato, i) => (
          <div
            class="reveal rounded-2xl p-5 flex flex-col gap-3 group transition-all duration-300 hover:-translate-y-1"
            style="background: white; border: 1px solid rgba(156,133,103,0.12); box-shadow: 0 2px 8px rgba(46,42,36,0.04);"
            class:list={[`reveal-d${i + 1}`]}
          >
            <!-- Icono con fondo de color -->
            <div
              class="w-10 h-10 rounded-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110"
              style={`background: ${dato.iconBg}; color: ${dato.iconColor};`}
            >
              <Icon name={dato.icon} size={18} />
            </div>

            <!-- Valor -->
            <div>
              {dato.count ? (
                <span
                  class="font-serif font-bold"
                  style="font-size: 1.9rem; line-height: 1; color: var(--color-carbon);"
                  data-count={dato.count}
                  data-prefix={dato.prefix ?? ''}
                >
                  {dato.prefix ?? ''}{dato.count}
                </span>
              ) : (
                <span
                  class="font-serif font-bold"
                  style="font-size: 1.9rem; line-height: 1; color: var(--color-carbon);"
                >
                  {dato.static}
                </span>
              )}
              {dato.suffix && (
                <span class="font-serif font-bold ml-0.5"
                      style="font-size: 1rem; color: var(--color-carbon);">
                  {dato.suffix}
                </span>
              )}
            </div>

            <span class="text-xs leading-snug" style="color: var(--color-piedra-media);">
              {dato.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
  </section>

  <!-- Accesos rápidos 3D ────────────────────────── -->
  <section class="bg-section-dark py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            href: '/historia',
            titulo: 'Historia y casas',
            desc: 'Mil años de historias, familias y patrimonio',
            icon: 'scroll',
            iconColor: '#C4773D',
            grad: 'from-[#2C1F14] to-[#3C2A1C]',
          },
          {
            href: '/que-ver',
            titulo: 'Qué ver y hacer',
            desc: 'Naturaleza, senderos y lugares únicos a pocos minutos',
            icon: 'footprints',
            iconColor: '#7C8A5C',
            grad: 'from-[#1C2818] to-[#263420]',
          },
          {
            href: '/arcusa-de-noche',
            titulo: 'Arcusa de noche',
            desc: 'Cielos limpios, silencio y estrellas sobre el Sobrarbe',
            icon: 'moon',
            iconColor: '#9FC0E0',
            grad: 'from-[#141A2B] to-[#1E2740]',
          },
          {
            href: '/eventos',
            titulo: 'Eventos',
            desc: 'Tradiciones, fiestas y actividades durante todo el año',
            icon: 'sparkles',
            iconColor: '#C4773D',
            grad: 'from-[#2C2010] to-[#3A2A18]',
          },
        ].map(item => (
          <a
            href={item.href}
            data-tilt
            class="relative rounded-2xl p-6 flex flex-col gap-5 overflow-hidden group"
            style={`
              background: rgba(255,255,255,0.04);
              border: 1px solid rgba(255,255,255,0.08);
              cursor: pointer;
              transition: box-shadow 0.35s ease, border-color 0.2s ease;
            `}
          >
            <!-- Icono con resplandor de fondo -->
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110"
              style={`background: ${item.iconColor}1A; color: ${item.iconColor};`}
            >
              <Icon name={item.icon} size={22} />
            </div>

            <div>
              <p class="font-serif font-semibold text-white text-lg leading-snug mb-1">
                {item.titulo}
              </p>
              <p class="text-sm leading-relaxed" style="color: rgba(205,187,160,0.65);">{item.desc}</p>
            </div>

            <!-- Flecha en esquina -->
            <div
              class="absolute bottom-5 right-5 w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              style={`background: ${item.iconColor}22; color: ${item.iconColor};`}
            >
              <Icon name="arrow-right" size={14} />
            </div>

            <!-- Resplandor hover en la esquina superior derecha -->
            <div
              class="absolute -top-12 -right-12 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`background: radial-gradient(circle, ${item.iconColor}20 0%, transparent 70%);`}
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Libro de visitantes ───────────────────────── -->
  <section class="bg-section-warm py-20 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

        <!-- Panel decorativo: los mismos pines del mapa real -->
        <div class="lg:col-span-5 reveal">
          <div class="lv-panel">
            <img src="/images/icons/chicheta-roja.png" alt="" class="lv-pin" style="top: 12%; left: 16%; width: 34px; transform: rotate(-14deg);" />
            <img src="/images/icons/chicheta-roja.png" alt="" class="lv-pin" style="top: 66%; left: 10%; width: 26px; transform: rotate(9deg);" />
            <img src="/images/icons/chicheta-roja.png" alt="" class="lv-pin" style="top: 20%; left: 78%; width: 30px; transform: rotate(16deg);" />
            <img src="/images/icons/chicheta-roja.png" alt="" class="lv-pin" style="top: 74%; left: 70%; width: 22px; transform: rotate(-8deg);" />
            <img src="/images/icons/chicheta-roja.png" alt="" class="lv-pin" style="top: 44%; left: 88%; width: 24px; transform: rotate(4deg);" />
            <img src="/images/icons/chincheta-dorada.png" alt="" class="lv-pin" style="top: 8%; left: 52%; width: 30px; transform: rotate(-6deg);" />

            <div class="lv-panel-stat">
              <span class="lv-panel-val" id="lv-total">–</span>
              <span class="lv-panel-label">huellas en el mapa</span>
            </div>
          </div>
        </div>

        <!-- Texto + CTAs -->
        <div class="lg:col-span-7 reveal reveal-d1">
          <SectionHeader
            eyebrow="Libro de visitantes"
            title="Deja tu huella en Arcusa"
          />
          <p class="leading-relaxed mb-6" style="color: var(--color-carbon-suave); font-size: 1.0625rem; max-width: 46ch;">
            Marca en el mapa de dónde vienes a visitar el pueblo y, si te atreves, busca los
            {totalSecretos} secretos escondidos por sus calles: cada uno tiene un código QR
            esperando a que lo encuentres.
          </p>

          <div class="flex flex-wrap gap-3 mb-8">
            <span class="lv-chip">
              <Icon name="globe" size={14} />
              <span id="lv-paises">–</span> países representados
            </span>
            <span class="lv-chip lv-chip-dorado">
              <Icon name="star" size={14} />
              {totalSecretos} secretos por descubrir
            </span>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/visitantes" class="btn-primary">
              <Icon name="map-pin" size={15} />
              Dejar mi huella
            </a>
            <a href="/visitantes#trivial" class="btn-outline">
              <Icon name="sparkles" size={15} />
              Buscar los secretos
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Próximos eventos ──────────────────────────── -->
  {proximosEventos.length > 0 && (
    <section class="bg-section-white-warm px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-7xl mx-auto">
        <SectionHeader
          eyebrow="Agenda"
          title="Próximos eventos"
          subtitle="Encuentros, fiestas y actividades que mantienen viva la vida del pueblo."
        />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {proximosEventos.map((evento, i) => (
            <div class={`reveal reveal-d${i + 1}`}>
              <CardEvento
                titulo={evento.data.titulo}
                fecha={evento.data.fecha}
                hora={evento.data.hora}
                lugar={evento.data.lugar}
                descripcion={evento.data.descripcion}
                imagen={evento.data.imagen}
                categoria={evento.data.categoria}
                slug={evento.id}
              />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/eventos" class="btn-outline">
            <Icon name="calendar" size={15} />
            Ver todos los eventos
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Museo highlight ───────────────────────────── -->
  <section class="bg-section-green relative py-24 overflow-hidden">

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">

        <!-- Texto -->
        <div class="lg:col-span-3 text-white reveal">
          <div class="flex items-center gap-3 mb-5">
            <span class="block w-6 h-px" style="background: rgba(255,255,255,0.3);" />
            <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-60">Arte y territorio</p>
          </div>
          <h2 class="font-serif font-bold mb-5" style="font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.1;">
            Cuando un pueblo decidió<br />pintar su memoria
          </h2>
          <p class="leading-relaxed mb-8" style="color: rgba(255,255,255,0.78); font-size: 1.0625rem; max-width: 38ch;">
            En 2020 nació una idea que transformó Arcusa. Lo que comenzó con un cuadro sobre la fachada de una casa
            se ha convertido en un museo al aire libre que recorre todo el pueblo. Cada obra guarda una parte de la
            memoria colectiva: vecinos, oficios, escenas del campo, tradiciones y momentos que forman parte de su historia.
            <br /><br />
            No es un museo encerrado entre cuatro paredes. Es el propio pueblo quien cuenta su historia mientras paseas
            por sus calles.
          </p>
          <a href="/museo" class="btn-ghost">
            Ver el museo completo
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <!-- Foto + stats verticales -->
        <div class="lg:col-span-2 flex flex-col gap-4 reveal reveal-d2">
          <div class="rounded-2xl overflow-hidden" style="aspect-ratio: 4/3; border: 1px solid rgba(255,255,255,0.14);">
            <img
              src="/images/puntos/Museo/test1.webp"
              alt="Uno de los murales del Museo de Pintura al Aire Libre de Arcusa"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          {[
            { valor: '48', label: 'obras por el pueblo', icon: 'brush' },
            { valor: '2020', label: 'año de inicio', icon: 'calendar' },
            { valor: 'Libre', label: 'entrada siempre', icon: 'check-circle' },
          ].map(stat => (
            <div
              class="flex items-center gap-4 px-5 py-4 rounded-2xl"
              style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(8px);"
            >
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
                style="background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.9);"
              >
                <Icon name={stat.icon} size={18} />
              </div>
              <div>
                <p class="font-serif text-2xl font-bold text-white leading-none">{stat.valor}</p>
                <p class="text-xs mt-0.5" style="color: rgba(255,255,255,0.55);">{stat.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Lugares destacados ────────────────────────── -->
  <section class="bg-section-warm py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Alrededores"
      title="Mucho por descubrir alrededor de Arcusa"
      subtitle="Arcusa es el punto de partida perfecto para descubrir algunos de los paisajes más espectaculares del Pirineo aragonés. A menos de una hora encontrarás la Sierra de Guara, Aínsa, Ordesa y decenas de pueblos que conservan intacta la esencia del Sobrarbe."
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {lugaresDestacados.map((lugar, i) => (
        <div class={`reveal reveal-d${i + 1} h-full`}>
          <CardLugar
            nombre={lugar.data.nombre}
            categoria={lugar.data.categoria}
            descripcion={lugar.data.descripcion}
            imagen={lugar.data.imagen}
            distancia={lugar.data.distancia}
            contacto={lugar.data.contacto}
            enlace={lugar.data.enlace}
          />
        </div>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/que-ver" class="btn-outline">
        <Icon name="eye" size={15} />
        Ver guía completa
      </a>
    </div>
  </div>
  </section>

  <Footer completo />
</Layout>

<style>
  /* ── Libro de visitantes: panel decorativo con los pines reales del mapa ── */
  .lv-panel {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, rgba(107, 88, 66, 0.1) 1px, transparent 0),
      radial-gradient(ellipse 70% 60% at 20% 15%, rgba(91, 127, 166, 0.1) 0%, transparent 55%),
      radial-gradient(ellipse 60% 55% at 85% 85%, rgba(196, 119, 61, 0.08) 0%, transparent 55%),
      #fff;
    background-size: 22px 22px, 100%, 100%, 100%;
    border: 1px solid rgba(156, 133, 103, 0.18);
    box-shadow: 0 20px 45px -20px rgba(46, 42, 36, 0.3);
  }
  .lv-pin {
    position: absolute;
    filter: drop-shadow(0 6px 10px rgba(46, 42, 36, 0.35));
    pointer-events: none;
  }
  .lv-panel-stat {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 1.4rem 1.8rem;
    border-radius: 1.15rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(156, 133, 103, 0.2);
    box-shadow: 0 10px 26px -10px rgba(46, 42, 36, 0.3);
    text-align: center;
  }
  .lv-panel-val {
    font-family: var(--font-serif);
    font-size: 2.3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-carbon);
  }
  .lv-panel-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-piedra-media);
    max-width: 14ch;
  }

  .lv-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-carbon-suave);
    background: #fff;
    border: 1px solid rgba(156, 133, 103, 0.22);
  }
  .lv-chip-dorado {
    color: #9C6B1F;
    background: rgba(232, 169, 106, 0.14);
    border-color: rgba(196, 119, 61, 0.35);
  }
</style>

<script>
  /* Contador en vivo del libro de visitantes: mismo endpoint que usa el
     mapa real en /visitantes (src/components/visitantes/MapaVisitantes.astro).
     Si el worker no responde (p. ej. en local sin API), se deja en '–'. */
  (async () => {
    const total = document.getElementById('lv-total');
    const paises = document.getElementById('lv-paises');
    if (!total || !paises) return;
    try {
      const res = await fetch('/api/pins');
      if (!res.ok) throw new Error('respuesta no ok');
      const pins: { pais?: string }[] = await res.json();
      total.textContent = String(pins.length);
      paises.textContent = String(new Set(pins.map(p => p.pais).filter(Boolean)).size);
    } catch {
      // silencioso: los chips se quedan con el guion de partida
    }
  })();
</script>
