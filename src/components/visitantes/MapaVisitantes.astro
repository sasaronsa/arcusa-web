---
import Icon from '../Icon.astro';
---

<!-- `.reveal` va en esta raíz, no en un `<div>` externo: su `transform`
     crearía un contenedor de referencia para `#mv-modal` (más abajo, ya
     fuera de este div) y le rompería el `position: fixed`. -->
<div id="mapa-visitantes-root" class="reveal">
  <div class="mv-stats" role="group" aria-label="Estadísticas de visitantes; pulsa cada una para ver el detalle">
    <button type="button" class="mv-stat" data-stat="visitantes" aria-haspopup="dialog">
      <Icon name="users" size={16} />
      <span class="mv-stat-val" id="mv-stat-total">–</span>
      <span class="mv-stat-label">Visitantes</span>
    </button>
    <button type="button" class="mv-stat" data-stat="paises" aria-haspopup="dialog">
      <Icon name="globe" size={16} />
      <span class="mv-stat-val" id="mv-stat-paises">–</span>
      <span class="mv-stat-label">Países</span>
    </button>
    <button type="button" class="mv-stat mv-stat-dorado" data-stat="dorados" aria-haspopup="dialog">
      <Icon name="star" size={16} />
      <span class="mv-stat-val" id="mv-stat-dorados">–</span>
      <span class="mv-stat-label">Huellas doradas</span>
    </button>
  </div>

  <div id="mv-canvas" class="mv-canvas"></div>

  <p id="mv-vacio" class="mv-vacio" hidden>
    Aún no hay pines en el mapa. ¡Sé la primera persona en dejar tu huella!
  </p>
</div>

<!-- Modal de detalle de las estadísticas (visitantes / países / dorados) -->
<div id="mv-modal" class="mv-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="mv-modal-titulo">
  <div class="mv-modal-backdrop" data-cerrar-mv></div>
  <div class="mv-modal-card" role="document">
    <button type="button" class="mv-modal-close" data-cerrar-mv aria-label="Cerrar">
      <Icon name="x" size={18} />
    </button>
    <p class="mv-modal-eyebrow">Libro de visitantes</p>
    <h3 class="mv-modal-titulo" id="mv-modal-titulo">&nbsp;</h3>
    <div id="mv-modal-body" class="mv-modal-body"></div>
  </div>
</div>

<!-- Visor de foto a pantalla completa: se reutiliza tanto desde el popup del
     mapa como desde las miniaturas del listado de visitantes. -->
<div id="mv-lightbox" class="mv-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Foto ampliada">
  <div class="mv-lightbox-backdrop" data-cerrar-lightbox></div>
  <button type="button" class="mv-lightbox-cerrar" data-cerrar-lightbox aria-label="Cerrar foto">
    <Icon name="x" size={20} />
  </button>
  <div class="mv-lightbox-frame arcusa-media">
    <img id="mv-lightbox-img" class="mv-lightbox-img" alt="" />
    <span class="arcusa-marca arcusa-marca-grande">✦ Arcusa</span>
  </div>
</div>

<style>
  .mv-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .mv-stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(156,133,103,0.25);
    color: var(--color-piedra-oscura);
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  .mv-stat:hover { background: #fff; border-color: rgba(156,133,103,0.4); transform: translateY(-1px); }
  .mv-stat-dorado { color: #9C6B1F; border-color: rgba(196,119,61,0.35); background: rgba(232,169,106,0.14); }
  .mv-stat-dorado:hover { background: rgba(232,169,106,0.22); border-color: rgba(196,119,61,0.5); }
  .mv-stat-val { font-family: var(--font-serif); font-weight: 700; font-size: 1.1rem; color: var(--color-carbon); }
  .mv-stat-dorado .mv-stat-val { color: #9C6B1F; }
  .mv-stat-label { font-size: 0.75rem; font-weight: 600; }

  .mv-canvas {
    width: 100%;
    height: 440px;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(156,133,103,0.3);
    box-shadow: 0 12px 30px rgba(46,42,36,0.12);
  }

  .mv-vacio {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-piedra-media);
  }

  /* Leaflet pone fondo blanco y borde a los divIcon por defecto (pensados
     para iconos cuadrados con imagen de fondo); la chincheta es SVG con
     su propio dibujo, así que se anulan aquí. */
  :global(.chincheta-icon.leaflet-div-icon) {
    background: transparent;
    border: none;
  }
  :global(.mv-pin) {
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
  }

  /* ── Popup "tipo post" ──
     Se quita todo el relleno por defecto de Leaflet para poder poner la
     foto a sangre (borde a borde) como cabecera de tarjeta, con el propio
     `overflow: hidden` del wrapper recortando sus esquinas — igual que una
     publicación de Instagram: usuario arriba, foto grande, luego lugar/
     fecha y el comentario a modo de descripción. */
  :global(.leaflet-popup-content-wrapper) {
    padding: 0;
    overflow: hidden;
    border-radius: 1.1rem;
    font-family: var(--font-sans);
    box-shadow: 0 16px 40px rgba(46,42,36,0.22);
  }
  :global(.leaflet-popup-content) { margin: 0; }
  :global(.leaflet-popup-tip-container) { margin-top: -1px; }

  :global(.mv-post) { display: flex; flex-direction: column; background: #fff; }
  :global(.mv-post-header) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.85rem 0.55rem;
  }
  :global(.mv-post-avatar) {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.78rem;
    color: #fff;
    background: linear-gradient(135deg, #D6362B, #A5432B);
  }
  :global(.mv-post-dorado .mv-post-avatar) {
    background: linear-gradient(135deg, #F0C088, #C4773D);
    color: #4A2F10;
  }
  :global(.mv-post-nombre) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-carbon);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.mv-post-media) {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-pergamino);
  }
  :global(.mv-post-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }
  :global(.mv-post-body) { padding: 0.6rem 0.85rem 0.8rem; }
  :global(.mv-post-meta) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-piedra-media);
    margin: 0 0 0.35rem;
  }
  :global(.mv-post-caption) {
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-carbon-suave);
    margin: 0;
  }

  /* ── Marca de agua + degradado, compartidos por el popup, el listado y el visor ── */
  :global(.arcusa-media) { position: relative; overflow: hidden; }
  :global(.arcusa-media)::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 42%;
    background: linear-gradient(to top, rgba(20,18,15,0.45), transparent);
    pointer-events: none;
  }
  :global(.arcusa-marca) {
    position: absolute;
    z-index: 1;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    font-family: var(--font-serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    background: rgba(20,18,15,0.4);
    backdrop-filter: blur(2px);
    pointer-events: none;
    white-space: nowrap;
  }
  :global(.arcusa-marca-grande) { right: 0.9rem; bottom: 0.9rem; padding: 0.3rem 0.75rem; font-size: 0.78rem; }

  /* ── Modal de detalle de estadísticas ── */
  .mv-modal {
    position: fixed;
    inset: 0;
    /* Muy por encima de los controles y paneles de Leaflet (hasta z-index
       1000 en su CSS): al no crear `.leaflet-container` un contexto de
       apilamiento propio, esos z-index compiten directamente con este. */
    z-index: 2000;
    display: flex;
    justify-content: center;
    padding: clamp(1rem, 6vh, 4rem) 1rem;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }
  .mv-modal.open { opacity: 1; visibility: visible; pointer-events: auto; }
  .mv-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(46, 42, 36, 0.55);
    backdrop-filter: blur(3px);
  }
  .mv-modal-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: auto;
    background: var(--color-pergamino);
    border-radius: 1.25rem;
    box-shadow: 0 24px 60px rgba(46, 42, 36, 0.35);
    padding: 1.75rem 1.5rem 1.5rem;
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
  }
  .mv-modal.open .mv-modal-card { transform: translateY(0) scale(1); opacity: 1; }
  .mv-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: var(--color-carbon);
    border: 1px solid rgba(156, 133, 103, 0.25);
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .mv-modal-close:hover { transform: scale(1.08); }
  .mv-modal-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ocre);
    margin-bottom: 0.3rem;
    padding-right: 2.5rem;
  }
  .mv-modal-titulo {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-carbon);
    margin-bottom: 1.1rem;
    padding-right: 2.5rem;
  }
  .mv-modal-body {
    max-height: 60vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* ── Contenido del modal, generado por JS ──
     IMPORTANTE: todo lo de aquí abajo se crea en tiempo de ejecución con
     `document.createElement` (ver el <script>). Astro solo añade su
     atributo de scope (`data-astro-cid-*`) a lo que ve en la plantilla al
     compilar; un elemento creado por JS nunca lo tiene, así que estas
     reglas DEBEN ir con `:global()` o nunca llegan a aplicarse (esa fue
     la causa de que el modal saliera como texto plano sin estilo). */

  /* Fila de la lista de visitantes / dorados */
  :global(.mv-fila) {
    position: relative;
    padding: 0.75rem 0.9rem 0.75rem 1.1rem;
    border-radius: 0.85rem;
    background: #fff;
    border: 1px solid rgba(156, 133, 103, 0.16);
    box-shadow: 0 2px 8px rgba(46, 42, 36, 0.05);
    overflow: hidden;
  }
  /* Filete de color a la izquierda: ocre normal, dorado para las huellas especiales. */
  :global(.mv-fila)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-ocre);
    opacity: 0.55;
  }
  :global(.mv-fila-dorado)::before {
    background: linear-gradient(180deg, #F0C088, #C4773D);
    opacity: 1;
  }
  :global(.mv-fila-cabecera) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  :global(.mv-fila-nombre) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--color-carbon);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(.mv-fila-nombre svg) { color: #C4773D; flex-shrink: 0; }
  :global(.mv-fila-fecha) { font-size: 0.7rem; color: var(--color-piedra-media); white-space: nowrap; flex-shrink: 0; }
  :global(.mv-fila-pais) {
    display: inline-flex;
    align-items: center;
    margin-top: 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    background: rgba(91, 127, 166, 0.1);
    color: var(--color-azul-pirineo);
    font-size: 0.72rem;
    font-weight: 600;
  }
  :global(.mv-fila-comentario) {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--color-carbon-suave);
  }

  /* Ranking de países */
  :global(.mv-rank-fila) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.85rem;
    background: #fff;
    border: 1px solid rgba(156, 133, 103, 0.14);
  }
  :global(.mv-rank-pos) {
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.82rem;
    background: rgba(156, 133, 103, 0.12);
    color: var(--color-piedra-oscura);
  }
  /* Los tres primeros puestos, con su propio color de podio. */
  :global(.mv-rank-pos-1) { background: linear-gradient(135deg, #F0C088, #C4773D); color: #fff; }
  :global(.mv-rank-pos-2) { background: rgba(156, 133, 103, 0.35); color: var(--color-carbon); }
  :global(.mv-rank-pos-3) { background: rgba(107, 88, 66, 0.22); color: var(--color-piedra-oscura); }
  :global(.mv-rank-info) { flex: 1; min-width: 0; }
  :global(.mv-rank-cabecera) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  :global(.mv-rank-pais) { font-weight: 600; color: var(--color-carbon); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.mv-rank-cuenta) {
    flex-shrink: 0;
    padding: 0.1rem 0.55rem;
    border-radius: 9999px;
    background: rgba(196, 119, 61, 0.12);
    color: var(--color-ocre);
    font-weight: 700;
    font-size: 0.72rem;
    white-space: nowrap;
  }
  :global(.mv-rank-barra) {
    height: 7px;
    border-radius: 9999px;
    background: rgba(156, 133, 103, 0.14);
    overflow: hidden;
  }
  :global(.mv-rank-barra-relleno) {
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--color-ocre), var(--color-ocre-suave));
  }

  :global(.mv-modal-vacio) {
    text-align: center;
    padding: 1.5rem 0.5rem;
    font-size: 0.9rem;
    color: var(--color-piedra-media);
  }

  :global(.mv-fila-media) {
    display: block;
    width: 100%;
    max-height: 130px;
    border-radius: 0.6rem;
    margin-top: 0.5rem;
  }
  :global(.mv-fila-foto) {
    display: block;
    width: 100%;
    max-height: 130px;
    object-fit: cover;
    cursor: zoom-in;
  }

  /* ── Visor de foto a pantalla completa ── */
  .mv-lightbox {
    position: fixed;
    inset: 0;
    z-index: 2100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mv-lightbox.open { opacity: 1; visibility: visible; pointer-events: auto; }
  .mv-lightbox-backdrop { position: absolute; inset: 0; background: rgba(20,18,15,0.9); }
  /* `arcusa-media` (compartida con el popup y el listado) se encarga del
     `position: relative` y del recorte; aquí solo el tamaño y la sombra
     propios del visor grande. */
  .mv-lightbox-frame {
    max-width: min(90vw, 800px);
    max-height: 85vh;
    border-radius: 0.75rem;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    line-height: 0;
  }
  .mv-lightbox-img {
    display: block;
    max-width: min(90vw, 800px);
    max-height: 85vh;
  }
  .mv-lightbox-cerrar {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.92);
    color: var(--color-carbon);
    border: none;
    cursor: pointer;
  }
  .mv-lightbox-cerrar:hover { background: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .mv-modal, .mv-modal-card, .mv-lightbox { transition: none; }
  }
</style>

<script>
  import L from 'leaflet';
  import { LOCALIZACIONES_TRIVIAL } from '../../data/trivial';
  import { chinchetaIcon } from '../../utils/mapPin';
  import 'leaflet/dist/leaflet.css';

  interface Pin {
    id: number;
    nombre: string;
    comentario: string | null;
    lat: number;
    lng: number;
    tipo: 'normal' | 'dorado';
    pais: string | null;
    foto_url: string | null;
    created_at: number;
  }

  const canvas = document.getElementById('mv-canvas');
  const vacio = document.getElementById('mv-vacio');
  if (!canvas) throw new Error('mv-canvas no encontrado');

  // Última respuesta de /api/pins, para que el modal de estadísticas no
  // tenga que volver a pedirla: se refresca cada vez que se pintan pines.
  let pinesCache: Pin[] = [];

  const map = L.map(canvas, { worldCopyJump: true }).setView([30, 10], 2);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 18,
  }).addTo(map);

  const iconoNormal = chinchetaIcon('#D6362B', 'mv-pin');
  const iconoDorado = chinchetaIcon('var(--color-ocre)', 'mv-pin');

  function icono(tipo: 'normal' | 'dorado') {
    return tipo === 'dorado' ? iconoDorado : iconoNormal;
  }

  // ── Visor de foto a pantalla completa ──
  // Un único lightbox reutilizado tanto por los popups del mapa (creados por
  // Leaflet vía innerHTML) como por las miniaturas del listado de
  // visitantes (creadas por JS más abajo): delegar el click por atributo
  // `data-foto-lightbox` evita enganchar un listener por cada imagen.
  const lightbox = document.getElementById('mv-lightbox');
  const lightboxImg = document.getElementById('mv-lightbox-img') as HTMLImageElement;

  function abrirLightbox(url: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = url;
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
  }
  function cerrarLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImg.src = '';
  }
  lightbox?.querySelectorAll<HTMLElement>('[data-cerrar-lightbox]').forEach((el) => {
    el.addEventListener('click', cerrarLightbox);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('open')) cerrarLightbox();
  });
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest<HTMLElement>('[data-foto-lightbox]');
    if (target) abrirLightbox(target.dataset.fotoLightbox!);
  });

  function formatoFecha(ts: number) {
    return new Date(ts).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function actualizarContadores(pins: Pin[]) {
    pinesCache = pins;
    const paises = new Set(pins.map((p) => p.pais).filter(Boolean));
    const dorados = pins.filter((p) => p.tipo === 'dorado').length;
    const total = document.getElementById('mv-stat-total');
    const ps = document.getElementById('mv-stat-paises');
    const dor = document.getElementById('mv-stat-dorados');
    if (total) total.textContent = String(pins.length);
    if (ps) ps.textContent = String(paises.size);
    if (dor) dor.textContent = String(dorados);
  }

  // Popup a modo de "post": cabecera con el nombre, foto a sangre (si hay),
  // y debajo lugar/fecha + comentario a modo de descripción — mismo orden
  // que pediría cualquier red de fotos.
  function pintarPin(p: Pin) {
    const marker = L.marker([p.lat, p.lng], { icon: icono(p.tipo) }).addTo(map);
    const nombreEsc = p.nombre.replace(/</g, '&lt;');
    const esDorado = p.tipo === 'dorado';

    const media = p.foto_url
      ? `
        <div class="mv-post-media arcusa-media">
          <img class="mv-post-img" src="${p.foto_url}" loading="lazy" alt="Foto de ${nombreEsc}" data-foto-lightbox="${p.foto_url}" />
          <span class="arcusa-marca">✦ Arcusa</span>
        </div>
      `
      : '';
    const caption = p.comentario
      ? `<p class="mv-post-caption">"${p.comentario.replace(/</g, '&lt;')}"</p>`
      : '';

    marker.bindPopup(
      `
      <div class="mv-post${esDorado ? ' mv-post-dorado' : ''}">
        <div class="mv-post-header">
          <span class="mv-post-avatar">${nombreEsc.charAt(0).toUpperCase()}</span>
          <span class="mv-post-nombre">${nombreEsc}${esDorado ? ' ⭐' : ''}</span>
        </div>
        ${media}
        <div class="mv-post-body">
          <p class="mv-post-meta">${p.pais ?? 'Origen desconocido'} · ${formatoFecha(p.created_at)}</p>
          ${caption}
        </div>
      </div>
    `,
      { minWidth: 230, maxWidth: 260 }
    );
  }

  // ── Modal de estadísticas (visitantes / países / dorados) ──
  // Construido con el DOM (createElement + textContent), no innerHTML con
  // texto interpolado: nombre/comentario/país los escribe cualquier
  // visitante y no queremos depender de un escape manual incompleto.
  const STAR_PATH =
    '<polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>';

  function svgEstrella(): SVGSVGElement {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('width', '12');
    svg.setAttribute('height', '12');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'currentColor');
    svg.setAttribute('aria-hidden', 'true');
    svg.innerHTML = STAR_PATH;
    return svg;
  }

  function filaVisitante(p: Pin): HTMLElement {
    const fila = document.createElement('div');
    fila.className = p.tipo === 'dorado' ? 'mv-fila mv-fila-dorado' : 'mv-fila';

    const cabecera = document.createElement('div');
    cabecera.className = 'mv-fila-cabecera';

    const nombre = document.createElement('p');
    nombre.className = 'mv-fila-nombre';
    nombre.append(document.createTextNode(p.nombre));
    if (p.tipo === 'dorado') nombre.append(svgEstrella());
    cabecera.append(nombre);

    const fecha = document.createElement('span');
    fecha.className = 'mv-fila-fecha';
    fecha.textContent = formatoFecha(p.created_at);
    cabecera.append(fecha);

    fila.append(cabecera);

    const pais = document.createElement('p');
    pais.className = 'mv-fila-pais';
    pais.textContent = p.pais ?? 'Origen desconocido';
    fila.append(pais);

    if (p.foto_url) {
      const media = document.createElement('div');
      media.className = 'mv-fila-media arcusa-media';

      const foto = document.createElement('img');
      foto.className = 'mv-fila-foto';
      foto.src = p.foto_url;
      foto.loading = 'lazy';
      foto.alt = `Foto de ${p.nombre}`;
      foto.dataset.fotoLightbox = p.foto_url;
      media.append(foto);

      const marca = document.createElement('span');
      marca.className = 'arcusa-marca';
      marca.textContent = '✦ Arcusa';
      media.append(marca);

      fila.append(media);
    }

    if (p.comentario) {
      const comentario = document.createElement('p');
      comentario.className = 'mv-fila-comentario';
      comentario.textContent = `"${p.comentario}"`;
      fila.append(comentario);
    }

    return fila;
  }

  function vacioModal(texto: string): HTMLElement {
    const p = document.createElement('p');
    p.className = 'mv-modal-vacio';
    p.textContent = texto;
    return p;
  }

  function construirVisitantes(pins: Pin[]): HTMLElement[] {
    if (pins.length === 0) return [vacioModal('Todavía no hay ninguna huella en el mapa.')];
    return [...pins].sort((a, b) => b.created_at - a.created_at).map(filaVisitante);
  }

  function construirDorados(pins: Pin[]): HTMLElement[] {
    const dorados = pins.filter((p) => p.tipo === 'dorado');
    if (dorados.length === 0) {
      return [vacioModal(`Nadie ha encontrado todavía los ${LOCALIZACIONES_TRIVIAL.length} secretos. ¡Sé la primera persona!`)];
    }
    return [...dorados].sort((a, b) => b.created_at - a.created_at).map(filaVisitante);
  }

  function construirRankingPaises(pins: Pin[]): HTMLElement[] {
    const conteo = new Map<string, number>();
    for (const p of pins) {
      if (!p.pais) continue;
      conteo.set(p.pais, (conteo.get(p.pais) ?? 0) + 1);
    }
    if (conteo.size === 0) return [vacioModal('Todavía no hay países registrados.')];

    const ranking = [...conteo.entries()].sort((a, b) => b[1] - a[1]);
    const maximo = ranking[0][1];

    return ranking.map(([pais, cuenta], i) => {
      const fila = document.createElement('div');
      fila.className = 'mv-rank-fila';

      const pos = document.createElement('span');
      // Insignia con medalla para el podio (1º/2º/3º); el resto, número plano.
      pos.className = i < 3 ? `mv-rank-pos mv-rank-pos-${i + 1}` : 'mv-rank-pos';
      pos.textContent = String(i + 1);
      fila.append(pos);

      const info = document.createElement('div');
      info.className = 'mv-rank-info';

      const cab = document.createElement('div');
      cab.className = 'mv-rank-cabecera';
      const nombrePais = document.createElement('span');
      nombrePais.className = 'mv-rank-pais';
      nombrePais.textContent = pais;
      const cuentaEl = document.createElement('span');
      cuentaEl.className = 'mv-rank-cuenta';
      cuentaEl.textContent = cuenta === 1 ? '1 huella' : `${cuenta} huellas`;
      cab.append(nombrePais, cuentaEl);
      info.append(cab);

      const barra = document.createElement('div');
      barra.className = 'mv-rank-barra';
      const relleno = document.createElement('div');
      relleno.className = 'mv-rank-barra-relleno';
      relleno.style.width = `${Math.max(6, (cuenta / maximo) * 100)}%`;
      barra.append(relleno);
      info.append(barra);

      fila.append(info);
      return fila;
    });
  }

  const CONFIG_MODAL: Record<string, { titulo: string; construir: (pins: Pin[]) => HTMLElement[] }> = {
    visitantes: { titulo: 'Todos los visitantes', construir: construirVisitantes },
    paises: { titulo: 'Ranking de países', construir: construirRankingPaises },
    dorados: { titulo: `Huellas doradas · los ${LOCALIZACIONES_TRIVIAL.length} secretos`, construir: construirDorados },
  };

  const mvModal = document.getElementById('mv-modal');
  const mvModalTitulo = document.getElementById('mv-modal-titulo');
  const mvModalBody = document.getElementById('mv-modal-body');
  let mvUltimoFoco: HTMLElement | null = null;

  function abrirModalStat(clave: string, disparador: HTMLElement) {
    const cfg = CONFIG_MODAL[clave];
    if (!cfg || !mvModal || !mvModalTitulo || !mvModalBody) return;

    mvModalTitulo.textContent = cfg.titulo;
    mvModalBody.replaceChildren(...cfg.construir(pinesCache));

    mvUltimoFoco = disparador;
    mvModal.classList.add('open');
    mvModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    mvModal.querySelector<HTMLElement>('.mv-modal-close')?.focus();
  }

  function cerrarModalStat() {
    if (!mvModal) return;
    mvModal.classList.remove('open');
    mvModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    mvUltimoFoco?.focus();
    mvUltimoFoco = null;
  }

  document.querySelectorAll<HTMLButtonElement>('.mv-stat[data-stat]').forEach((btn) => {
    btn.addEventListener('click', () => abrirModalStat(btn.dataset.stat!, btn));
  });
  mvModal?.querySelectorAll<HTMLElement>('[data-cerrar-mv]').forEach((el) => {
    el.addEventListener('click', cerrarModalStat);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mvModal?.classList.contains('open')) cerrarModalStat();
  });

  async function cargarPines() {
    try {
      const res = await fetch('/api/pins');
      if (!res.ok) throw new Error('respuesta no ok');
      const pins: Pin[] = await res.json();
      actualizarContadores(pins);
      if (pins.length === 0 && vacio) vacio.hidden = false;
      pins.forEach(pintarPin);
    } catch {
      actualizarContadores([]);
      if (vacio) {
        vacio.hidden = false;
        vacio.textContent = 'No se ha podido cargar el mapa de visitantes. Inténtalo de nuevo más tarde.';
      }
    }
  }

  cargarPines();

  window.addEventListener('arcusa:pin-creado', ((e: CustomEvent<Pin>) => {
    if (vacio) vacio.hidden = true;
    pintarPin(e.detail);
    map.flyTo([e.detail.lat, e.detail.lng], Math.max(map.getZoom(), 5));
    fetch('/api/pins')
      .then((r) => r.json())
      .then(actualizarContadores)
      .catch(() => {});
  }) as EventListener);
</script>
