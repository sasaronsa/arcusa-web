---
import Icon from '../Icon.astro';
import EscanerQR from './EscanerQR.astro';
import { LOCALIZACIONES_TRIVIAL } from '../../data/trivial';
const total = LOCALIZACIONES_TRIVIAL.length;
---

<div id="pt-root" class="pt-card">
  <div class="pt-header">
    <Icon name="sparkles" size={20} style="color: var(--color-ocre);" />
    <div>
      <h3 class="pt-title">Los {total} secretos de Arcusa</h3>
      <p class="pt-subtitle">
        ¿Te atreves a encontrarlos? Busca los QR repartidos por el pueblo y escanéalos aquí mismo.
        Quien los encuentre todos deja una huella especial —dorada— en el mapa.
      </p>
    </div>
  </div>

  <EscanerQR />

  <p class="pt-progreso">
    <span id="pt-contador">0</span>/{total} encontrados
  </p>

  <p id="pt-toast" class="pt-toast" hidden></p>

  <div class="pt-grid">
    {LOCALIZACIONES_TRIVIAL.map((loc) => (
      <div class="pt-slot" data-slug={loc.slug} data-nombre={loc.nombre} data-foto={loc.foto ?? ''}>
        <div class="pt-slot-media">
          <Icon name={loc.icon} size={18} />
        </div>
        <p class="pt-slot-nombre">?</p>
        <p class="pt-slot-pista">{loc.pista}</p>
      </div>
    ))}
  </div>

  <p id="pt-completo" class="pt-completo" hidden>
    <Icon name="star" size={16} />
    ¡Has encontrado los {total} secretos! Marca la casilla dorada en el formulario para dejar tu huella especial.
  </p>
</div>

<div id="pt-celebracion" class="pt-celebracion" hidden aria-hidden="true">
  <div class="pt-celebracion-confeti" aria-hidden="true"></div>
  <div class="pt-celebracion-card">
    <div class="pt-celebracion-icon"><Icon name="party-popper" size={30} /></div>
    <h3>¡Enhorabuena, has encontrado los {total} secretos de Arcusa!</h3>
    <p>Ya puedes dejar tu huella dorada en el mapa de visitantes.</p>
    <button id="pt-celebracion-cerrar" type="button" class="btn-primary">
      Dejar mi huella dorada
    </button>
  </div>
</div>

<style>
  .pt-card {
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(156,133,103,0.25);
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 12px 30px rgba(46,42,36,0.1);
  }
  .pt-header { display: flex; gap: 0.75rem; margin-bottom: 1rem; }
  .pt-title { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 700; color: var(--color-carbon); }
  .pt-subtitle { font-size: 0.86rem; color: var(--color-piedra-media); margin-top: 0.25rem; line-height: 1.5; }

  .pt-progreso {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-ocre);
    margin: 1.1rem 0 0.75rem;
  }

  .pt-toast {
    margin-bottom: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.75rem;
    background: rgba(62,92,58,0.1);
    color: var(--color-verde-pino);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .pt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }
  .pt-slot {
    padding: 0.85rem;
    border-radius: 0.9rem;
    background: rgba(244,239,230,0.6);
    border: 1px dashed rgba(156,133,103,0.4);
    text-align: center;
    transition: background 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }
  .pt-slot-media {
    width: 34px; height: 34px;
    margin: 0 auto 0.5rem;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(156,133,103,0.18);
    color: var(--color-piedra-oscura);
  }
  .pt-slot-nombre { font-weight: 700; font-size: 0.85rem; color: var(--color-piedra-media); margin-bottom: 0.2rem; }
  .pt-slot-pista { font-size: 0.74rem; color: var(--color-piedra-media); line-height: 1.4; }

  .pt-slot.encontrado {
    background: rgba(62,92,58,0.09);
    border: 1px solid rgba(62,92,58,0.3);
  }
  .pt-slot.encontrado .pt-slot-media { background: var(--color-verde-pino); color: white; }
  .pt-slot.encontrado .pt-slot-nombre { color: var(--color-verde-pino); }
  .pt-slot.encontrado .pt-slot-pista { display: none; }

  .pt-slot.encontrado.con-foto {
    padding: 0;
    border-style: solid;
  }
  .pt-slot.encontrado.con-foto .pt-slot-media {
    width: 100%;
    height: 90px;
    margin: 0;
    border-radius: 0;
    background-size: cover;
    background-position: center;
  }
  .pt-slot.encontrado.con-foto .pt-slot-media :global(svg) { display: none; }
  .pt-slot.encontrado.con-foto .pt-slot-nombre { padding: 0.5rem 0.6rem 0.7rem; margin: 0; }

  .pt-completo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.8rem 1rem;
    border-radius: 0.9rem;
    background: rgba(232,169,106,0.16);
    border: 1px solid rgba(196,119,61,0.35);
    color: #9C6B1F;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* ── Celebración al completarlos todos ── */
  .pt-celebracion {
    position: fixed;
    inset: 0;
    z-index: 250;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(20,18,15,0.82);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .pt-celebracion.open { opacity: 1; visibility: visible; }
  .pt-celebracion-card {
    position: relative;
    z-index: 1;
    max-width: 380px;
    text-align: center;
    background: var(--color-pergamino);
    border-radius: 1.5rem;
    padding: 2.25rem 1.75rem;
    box-shadow: 0 30px 70px rgba(0,0,0,0.4);
  }
  .pt-celebracion-icon {
    width: 60px; height: 60px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #E8A96A, #C4773D);
    color: white;
  }
  .pt-celebracion-card h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-carbon);
    margin-bottom: 0.6rem;
  }
  .pt-celebracion-card p {
    font-size: 0.92rem;
    color: var(--color-carbon-suave);
    margin-bottom: 1.5rem;
  }

  .pt-celebracion-confeti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .pt-celebracion-confeti::before,
  .pt-celebracion-confeti::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(4px 4px at 10% -5%, #E8A96A 100%, transparent),
      radial-gradient(4px 4px at 30% -8%, #5B7FA6 100%, transparent),
      radial-gradient(4px 4px at 50% -3%, #3E5C3A 100%, transparent),
      radial-gradient(4px 4px at 70% -10%, #C4773D 100%, transparent),
      radial-gradient(4px 4px at 90% -6%, #7C8A5C 100%, transparent);
    animation: pt-caer 2.6s linear infinite;
  }
  .pt-celebracion-confeti::after { animation-delay: 1.1s; background-position: 5% 0; }
  @keyframes pt-caer {
    from { transform: translateY(-10%); opacity: 1; }
    to   { transform: translateY(110vh); opacity: 0.6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-celebracion-confeti::before, .pt-celebracion-confeti::after { animation: none; display: none; }
  }
</style>

<script>
  import { leerEstadoTrivial, EVENTO_SECRETO_ENCONTRADO, type EstadoTrivial } from '../../data/trivial';

  const contador = document.getElementById('pt-contador')!;
  const completo = document.getElementById('pt-completo')!;
  const toast = document.getElementById('pt-toast')!;
  const celebracion = document.getElementById('pt-celebracion')!;
  const celebracionCerrar = document.getElementById('pt-celebracion-cerrar')!;
  let toastTimeout = 0;

  function pintar(estado: EstadoTrivial) {
    contador.textContent = String(estado.encontrados.length);
    completo.hidden = estado.encontrados.length < 6;

    document.querySelectorAll<HTMLElement>('.pt-slot').forEach((slot) => {
      const slug = slot.dataset.slug!;
      if (!estado.encontrados.includes(slug)) return;
      slot.classList.add('encontrado');
      const nombreEl = slot.querySelector<HTMLElement>('.pt-slot-nombre');
      if (nombreEl) nombreEl.textContent = slot.dataset.nombre ?? '✓';
      const foto = slot.dataset.foto;
      if (foto) {
        slot.classList.add('con-foto');
        const media = slot.querySelector<HTMLElement>('.pt-slot-media');
        if (media) media.style.backgroundImage = `url("${foto}")`;
      }
    });
  }

  pintar(leerEstadoTrivial());

  function mostrarCelebracion() {
    celebracion.classList.add('open');
    celebracion.setAttribute('aria-hidden', 'false');
  }
  function cerrarCelebracion() {
    celebracion.classList.remove('open');
    celebracion.setAttribute('aria-hidden', 'true');
    document.getElementById('fp-dorado-wrap')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  celebracionCerrar.addEventListener('click', cerrarCelebracion);
  celebracion.addEventListener('click', (e) => {
    if (e.target === celebracion) cerrarCelebracion();
  });

  window.addEventListener(EVENTO_SECRETO_ENCONTRADO, ((e: CustomEvent) => {
    const { estado, yaEstaba, completadoAhora } = e.detail;
    pintar(estado);
    if (!yaEstaba) {
      clearTimeout(toastTimeout);
      toast.textContent = '¡Nuevo secreto añadido a tu colección!';
      toast.hidden = false;
      toastTimeout = window.setTimeout(() => { toast.hidden = true; }, 3500);
    }
    if (completadoAhora) mostrarCelebracion();
  }) as EventListener);
</script>
