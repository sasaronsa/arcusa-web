---
import Icon from '../Icon.astro';
import { LOCALIZACIONES_TRIVIAL } from '../../data/trivial';
const totalSecretos = LOCALIZACIONES_TRIVIAL.length;
---

<!-- `reveal` va en esta misma raíz (no envuelto desde fuera): un `.reveal`
     externo le pondría un `transform` a un ancestro y rompería el
     `position: fixed` del modal de mapa a pantalla completa de más abajo —
     mismo motivo por el que MapaVisitantes aplica `.reveal` a su propia raíz
     en vez de heredarlo de un `<div>` envolvente. -->
<div id="fp-root" class="fp-card reveal">
  <h3 class="fp-title">Deja tu huella en el mapa</h3>
  <p class="fp-subtitle">Toca el mapa para marcar de dónde vienes, escribe tu nombre y, si quieres, un comentario.</p>

  <!-- El botón va en su propia fila, no superpuesto al mapa: Leaflet pinta
       sus panos en una capa acelerada por GPU que en algunos navegadores
       (Chromium incluido) puede quedar por encima de un hermano superpuesto
       aunque el DOM, el z-index y hasta elementsFromPoint digan lo
       contrario — es un desajuste entre el compositor y el hit-test, no
       algo que se pueda arreglar subiendo el z-index. Fuera de la zona del
       mapa, el problema no existe. -->
  <div class="fp-picker-toolbar">
    <button type="button" id="fp-picker-ampliar" class="fp-picker-ampliar">
      <Icon name="maximize" size={14} />
      Ampliar mapa
    </button>
  </div>
  <div class="fp-picker-wrap">
    <div id="fp-picker" class="fp-picker"></div>
  </div>
  <p id="fp-picker-hint" class="fp-picker-hint">
    <Icon name="map-pin" size={13} />
    Toca el mapa para elegir tu ubicación
  </p>

  <!-- Mapa a pantalla completa: el <div> del mapa (#fp-picker) se traslada
       aquí dentro mientras el modal está abierto y vuelve a su sitio al
       cerrarlo. Es el mismo mapa Leaflet, no una copia — así la selección
       ya hecha (o la que se haga aquí) es siempre una sola fuente de verdad. -->
  <div id="fp-picker-modal" class="fp-picker-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Elegir ubicación en el mapa">
    <div class="fp-picker-modal-backdrop" data-cerrar-picker-modal></div>
    <div class="fp-picker-modal-card">
      <div class="fp-picker-modal-header">
        <p><Icon name="map-pin" size={14} /> Toca el mapa para marcar tu ubicación</p>
        <button type="button" class="fp-picker-modal-cerrar" data-cerrar-picker-modal aria-label="Cerrar mapa">
          <Icon name="x" size={18} />
        </button>
      </div>
      <div id="fp-picker-modal-slot" class="fp-picker-modal-slot"></div>
      <button type="button" id="fp-picker-modal-confirmar" class="btn-primary fp-picker-modal-confirmar">
        <Icon name="check" size={15} />
        Confirmar ubicación
      </button>
    </div>
  </div>

  <form id="fp-form" class="fp-form">
    <label class="fp-label">
      Tu nombre
      <input id="fp-nombre" name="nombre" type="text" maxlength="30" required placeholder="Ej. Marta" class="fp-input" />
      <span class="fp-counter"><span id="fp-nombre-count">0</span>/30</span>
    </label>

    <label class="fp-label">
      Comentario <span class="fp-opcional">(opcional)</span>
      <textarea id="fp-comentario" name="comentario" maxlength="150" rows="3" placeholder="¿Qué te ha traído hasta Arcusa?" class="fp-input fp-textarea"></textarea>
      <span class="fp-counter"><span id="fp-comentario-count">0</span>/150</span>
    </label>

    <label id="fp-dorado-wrap" class="fp-dorado" hidden>
      <input id="fp-dorado" type="checkbox" />
      <span>
        <strong>Dejar mi huella dorada</strong> — has encontrado los {totalSecretos} secretos de Arcusa, ¡tu pin puede brillar de forma especial!
      </span>
    </label>

    <button id="fp-submit" type="submit" class="btn-primary" disabled>
      <Icon name="map-pin" size={15} />
      Dejar mi huella
    </button>

    <p id="fp-mensaje" class="fp-mensaje" role="status" hidden></p>
  </form>
</div>

<style>
  .fp-card {
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(156,133,103,0.25);
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 12px 30px rgba(46,42,36,0.1);
  }
  .fp-title { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 700; color: var(--color-carbon); margin-bottom: 0.35rem; }
  .fp-subtitle { font-size: 0.9rem; color: var(--color-piedra-media); margin-bottom: 1rem; }

  .fp-picker-wrap { position: relative; }
  .fp-picker {
    width: 100%;
    height: 220px;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(156,133,103,0.3);
    cursor: crosshair;
  }
  /* El botón vive en su propia fila, no superpuesto al mapa — ver el
     comentario junto a su marcado en la plantilla: Leaflet pinta sus panos
     en una capa acelerada por GPU que en Chromium puede quedar por encima
     de un hermano superpuesto pase lo que pase con el z-index. */
  .fp-picker-toolbar { display: flex; justify-content: flex-end; margin-bottom: 0.5rem; }
  .fp-picker-ampliar {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-carbon-suave);
    background: var(--color-pergamino);
    border: 1px solid rgba(156,133,103,0.3);
    cursor: pointer;
  }
  .fp-picker-ampliar:hover { background: rgba(156,133,103,0.16); color: var(--color-carbon); }
  .fp-picker-hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 0 1.25rem;
    font-size: 0.78rem;
    color: var(--color-piedra-media);
  }

  /* ══════ Mapa a pantalla completa ══════ */
  .fp-picker-modal {
    position: fixed;
    inset: 0;
    z-index: 220;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .fp-picker-modal.open { opacity: 1; visibility: visible; }
  .fp-picker-modal-backdrop { position: fixed; inset: 0; background: rgba(20,18,15,0.82); }
  .fp-picker-modal-card {
    position: relative;
    width: 100%;
    max-width: 720px;
    height: min(88vh, 720px);
    display: flex;
    flex-direction: column;
    background: var(--color-pergamino);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(0,0,0,0.45);
  }
  .fp-picker-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(156,133,103,0.2);
  }
  .fp-picker-modal-header p {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-carbon);
    margin: 0;
  }
  .fp-picker-modal-cerrar {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(156,133,103,0.14);
    color: var(--color-carbon);
    border: none;
    cursor: pointer;
  }
  .fp-picker-modal-cerrar:hover { background: rgba(156,133,103,0.24); }
  .fp-picker-modal-slot { flex: 1; min-height: 0; cursor: crosshair; }
  .fp-picker-modal-slot :global(.fp-picker) { height: 100%; border-radius: 0; border: none; }
  .fp-picker-modal-confirmar { margin: 0.9rem 1rem 1rem; justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .fp-picker-modal { transition: none; }
  }

  .fp-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .fp-label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-carbon);
    position: relative;
  }
  .fp-opcional { font-weight: 400; color: var(--color-piedra-media); }
  .fp-input {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.95rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(156,133,103,0.35);
    background: white;
    color: var(--color-carbon);
  }
  .fp-input:focus { outline: 2px solid var(--color-azul-pirineo); outline-offset: 1px; }
  .fp-textarea { resize: vertical; min-height: 4.5rem; }
  .fp-counter {
    position: absolute;
    right: 0.2rem;
    top: 0;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-piedra-media);
  }

  .fp-dorado {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: 0.9rem;
    background: rgba(232,169,106,0.14);
    border: 1px solid rgba(196,119,61,0.3);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-carbon-suave);
    cursor: pointer;
  }
  .fp-dorado input {
    margin-top: 0.2rem;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    accent-color: var(--color-ocre);
  }

  #fp-submit { justify-content: center; }
  #fp-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; box-shadow: none !important; }

  .fp-mensaje {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.7rem 1rem;
    border-radius: 0.75rem;
  }
  .fp-mensaje.ok { background: rgba(62,92,58,0.1); color: var(--color-verde-pino); }
  .fp-mensaje.error { background: rgba(196,87,61,0.1); color: #A5432B; }

  :global(.fp-pin) {
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { leerEstadoTrivial, tokenParaEncontrados, EVENTO_SECRETO_ENCONTRADO, ALL_SLUGS } from '../../data/trivial';

  const pickerEl = document.getElementById('fp-picker')!;
  const pickerWrap = document.querySelector('.fp-picker-wrap')!;
  const ampliarBtn = document.getElementById('fp-picker-ampliar') as HTMLButtonElement;
  const pickerModal = document.getElementById('fp-picker-modal')!;
  const pickerModalSlot = document.getElementById('fp-picker-modal-slot')!;
  // Se traslada a document.body: tal como queda escrito en la plantilla,
  // el modal cuelga de #fp-root, y ese nodo lleva `.reveal` (transform),
  // que le crearía un contenedor de referencia y le rompería el
  // `position: fixed` (ver aviso junto a <MapaVisitantes /> en
  // visitantes/index.astro — mismo problema, aquí resuelto reubicando el
  // nodo por JS en vez de reordenando la plantilla).
  document.body.appendChild(pickerModal);
  const pickerModalConfirmar = document.getElementById('fp-picker-modal-confirmar')!;
  const hint = document.getElementById('fp-picker-hint')!;
  const form = document.getElementById('fp-form') as HTMLFormElement;
  const nombreInput = document.getElementById('fp-nombre') as HTMLInputElement;
  const comentarioInput = document.getElementById('fp-comentario') as HTMLTextAreaElement;
  const nombreCount = document.getElementById('fp-nombre-count')!;
  const comentarioCount = document.getElementById('fp-comentario-count')!;
  const doradoWrap = document.getElementById('fp-dorado-wrap') as HTMLLabelElement;
  const doradoCheck = document.getElementById('fp-dorado') as HTMLInputElement;
  const submitBtn = document.getElementById('fp-submit') as HTMLButtonElement;
  const mensaje = document.getElementById('fp-mensaje')!;

  let seleccion: { lat: number; lng: number } | null = null;
  let marker: L.Marker | null = null;

  const iconoSeleccionNormal = L.icon({
    className: 'fp-pin',
    iconUrl: '/images/icons/chicheta-roja.png',
    iconSize: [30, 30],
    iconAnchor: [15, 15],
  });
  const iconoSeleccionDorado = L.icon({
    className: 'fp-pin',
    iconUrl: '/images/icons/chincheta-dorada.png',
    iconSize: [30, 30],
    iconAnchor: [15, 15],
  });

  // El pin de vista previa es dorado solo si la casilla está marcada Y de
  // verdad hay derecho a ello (los 4 secretos encontrados) — igual que la
  // condición real que decide el `tipo` al enviar el formulario.
  function quiereDoradoAhora() {
    return doradoCheck.checked && estadoTrivial.encontrados.length >= ALL_SLUGS.length;
  }
  function iconoActual() {
    return quiereDoradoAhora() ? iconoSeleccionDorado : iconoSeleccionNormal;
  }

  const picker = L.map(pickerEl, { worldCopyJump: true }).setView([30, 10], 2);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap',
    maxZoom: 18,
  }).addTo(picker);

  function actualizarSubmit() {
    submitBtn.disabled = !seleccion || nombreInput.value.trim().length === 0;
  }

  picker.on('click', (e: L.LeafletMouseEvent) => {
    seleccion = { lat: e.latlng.lat, lng: e.latlng.lng };
    if (marker) marker.setLatLng(e.latlng);
    else marker = L.marker(e.latlng, { icon: iconoActual() }).addTo(picker);
    hint.textContent = '';
    hint.style.display = 'none';
    actualizarSubmit();
  });

  // Si ya hay un pin puesto, marcar/desmarcar la casilla lo repinta al vuelo.
  doradoCheck.addEventListener('change', () => {
    marker?.setIcon(iconoActual());
  });

  // ── Mapa a pantalla completa ──
  // El <div> del mapa (#fp-picker) se traslada al modal y vuelve a su sitio
  // al cerrar: es la misma instancia de Leaflet, no una copia, así que la
  // selección siempre vive en un solo lugar. `invalidateSize()` es
  // obligatorio tras cambiar el tamaño real del contenedor o Leaflet sigue
  // calculando con las medidas antiguas.
  function abrirPickerModal() {
    pickerModalSlot.appendChild(pickerEl);
    pickerModal.classList.add('open');
    pickerModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => picker.invalidateSize());
  }
  function cerrarPickerModal() {
    pickerWrap.insertBefore(pickerEl, pickerWrap.firstChild);
    pickerModal.classList.remove('open');
    pickerModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    requestAnimationFrame(() => picker.invalidateSize());
  }
  ampliarBtn.addEventListener('click', abrirPickerModal);
  pickerModalConfirmar.addEventListener('click', cerrarPickerModal);
  pickerModal.querySelectorAll('[data-cerrar-picker-modal]').forEach((el) => {
    el.addEventListener('click', cerrarPickerModal);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && pickerModal.classList.contains('open')) cerrarPickerModal();
  });

  nombreInput.addEventListener('input', () => {
    nombreCount.textContent = String(nombreInput.value.length);
    actualizarSubmit();
  });
  comentarioInput.addEventListener('input', () => {
    comentarioCount.textContent = String(comentarioInput.value.length);
  });

  let estadoTrivial = leerEstadoTrivial();
  if (estadoTrivial.encontrados.length >= ALL_SLUGS.length) {
    doradoWrap.hidden = false;
  }

  window.addEventListener(EVENTO_SECRETO_ENCONTRADO, ((e: CustomEvent) => {
    estadoTrivial = e.detail.estado;
    if (estadoTrivial.encontrados.length >= ALL_SLUGS.length) doradoWrap.hidden = false;
  }) as EventListener);

  function mostrarMensaje(texto: string, tipo: 'ok' | 'error') {
    mensaje.textContent = texto;
    mensaje.className = `fp-mensaje ${tipo}`;
    mensaje.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!seleccion) return;
    submitBtn.disabled = true;
    mensaje.hidden = true;

    const quiereDorado = doradoCheck.checked && estadoTrivial.encontrados.length >= ALL_SLUGS.length;
    const token = quiereDorado ? await tokenParaEncontrados(estadoTrivial.encontrados) : undefined;

    try {
      const res = await fetch('/api/pins', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: nombreInput.value.trim(),
          comentario: comentarioInput.value.trim(),
          lat: seleccion.lat,
          lng: seleccion.lng,
          tipo: quiereDorado ? 'dorado' : 'normal',
          token,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        mostrarMensaje(data.error ?? 'No se ha podido guardar tu huella. Inténtalo de nuevo.', 'error');
        actualizarSubmit();
        return;
      }

      mostrarMensaje('¡Gracias por dejar tu huella en Arcusa!', 'ok');
      window.dispatchEvent(new CustomEvent('arcusa:pin-creado', { detail: data }));
      form.reset();
      nombreCount.textContent = '0';
      comentarioCount.textContent = '0';
      if (marker) { picker.removeLayer(marker); marker = null; }
      seleccion = null;
      doradoWrap.hidden = estadoTrivial.encontrados.length < ALL_SLUGS.length;
      hint.style.display = 'flex';
      actualizarSubmit();
    } catch {
      mostrarMensaje('No se ha podido conectar. Comprueba tu conexión e inténtalo de nuevo.', 'error');
      actualizarSubmit();
    }
  });
</script>
